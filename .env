# Domain
# Set this to your internal domain name that will be registered in your company DNS
DOMAIN=test-app.internal

# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST=http://dashboard.${DOMAIN}

# Environment: local, staging, production
ENVIRONMENT=staging

PROJECT_NAME="Full Stack FastAPI Project"
STACK_NAME=full-stack-fastapi-project

# Backend
# Update with your internal domain addresses
BACKEND_CORS_ORIGINS="http://dashboard.${DOMAIN},http://api.${DOMAIN},http://adminer.${DOMAIN},http://traefik.${DOMAIN}"
SECRET_KEY=H39dke8Jd92jdieW02kdMwoidi29djKsiwo29dmK
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=admin_secure_password_2024

# Emails
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_2024

SENTRY_DSN=

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
